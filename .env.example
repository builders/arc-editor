# TinaCloud credentials — from the arc-data project in TinaCloud, NOT arc-editor.
# See: https://app.tina.io → your arc-data project → Overview / Tokens tabs.
#
# Setup order:
#   1. Register arc-editor in TinaCloud → note its Client ID (used in arc-data/tina/meta.json)
#   2. Register arc-data  in TinaCloud → copy its Client ID and token here
#   3. Add tina/meta.json to arc-data with arc-editor's Client ID (already done as placeholder)

# Client ID from the arc-data TinaCloud project (Overview tab)
PUBLIC_TINA_CLIENT_ID=your_arc_data_tinacloud_client_id

# Content token from the arc-data TinaCloud project (Tokens tab)
TINA_TOKEN=your_arc_data_tinacloud_token

# Branch Tina reads and writes content to
TINA_PUBLIC_EDIT_BRANCH=main

{
  "name": "arc-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build && astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc -b tsconfig.worker.json",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "tinacms": "^2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@tinacms/cli": "^1.6.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.0.0"
  }
}
